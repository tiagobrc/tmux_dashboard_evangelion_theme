#!/usr/bin/env python3
"""Live panel of the running Claude Code sessions, for the tmux dashboard window.

One row per running session (claude_sessions.registry(); a session open in two windows is one row, flagged red ×2):
its window (w3 in this tmux session, 0:w3 in another), a status dot, its topic (the pane title Claude keeps), and its
context, the same numbers as the session browser:

  ctx    tokens every step re-sends - yellow from CTX_WARN_K, red from CTX_CLEAR_K
  step   what each step costs while the cache is warm ($.05 = 5 cents)
  warm   how long the cache stays warm (theme colour; yellow under NUDGE_MIN minutes for an idle session), or
         ↻$2.4 = cold: the next step rewrites the whole context for $2.40
  spent  the session's total at API prices;  used  how long since its last activity

Busy sessions first, then the warm ones (soonest cold first), then the cold ones by cost to wake, dearest first. Rows
that do not fit end in "… N more · K over 400K hidden"; the legend only shows when everything else fits.

Cache-expiry nudge: when an idle session past CTX_WARN_K has under NUDGE_MIN (10) minutes of warm cache left, one tmux
message goes to the clients of this panel's tmux session - once per session and expiry across every dashboard (a marker
in ~/.claude/dash/nudged/). Checked every NUDGE_EVERY s from the status snapshots, also while the window is hidden.
NUDGE_MIN=0 turns it off. CLAUDE_DASH_MARKERS moves the marker folder (tests).
"""
import os, re, shutil, signal, subprocess, sys, threading, time, unicodedata
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import claude_sessions as cs
import dashlib

SNAPSHOT = Path.home() / ".tmux-claude-restore.sh"
NUDGED = Path(os.environ.get("CLAUDE_DASH_MARKERS") or Path.home() / ".claude" / "dash") / "nudged"
SEP = "\x1f"
BOLD, OFF = "\033[1m", "\033[0m"
GREY = "\033[37m"                                         # secondary text: dim (\033[2m) is ~2.3:1 on the MAGI orange
LEVEL = {1: "\033[1;33m", 2: "\033[1;91m"}                # context past CTX_WARN_K yellow, past CTX_CLEAR_K bright red
RED = LEVEL[2]
DOT = {"busy": "\033[1;97m", "idle": "\033[32m", "shell": "\033[36m"}   # busy is bold white: yellow means a threshold
FRAME_EVERY = 3                                           # seconds between frames
CTX_EVERY = 10                                            # seconds between build()s (titles, spend, transcript usage)
NUDGE_EVERY = 60                                          # seconds between nudge checks, visible or not
COLUMNS = ("ctx", "step", "warm", "spent", "used")
DROP = ("spent", "used")                                  # dropped in this order when the title would get under MIN_TITLE
MIN_TITLE = 12
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
_rows = {"at": 0, "by_id": {}}
_tidied = [0]


def warm_tint():
    """Warm cache - this session pays per step right now: the theme's second colour, else bright cyan (bold for the
    price, plain for the minutes, as in the session browser)."""
    return dashlib.theme("second", "\033[96m")


# ---- text that fits: cells, not characters (titles can hold wide characters) ----
def _w(ch):
    return 0 if unicodedata.combining(ch) else 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def cells(s):
    return sum(map(_w, ANSI.sub("", s)))


def cut(s, n):
    """Plain text `s` in at most `n` cells, '…' when cut."""
    if cells(s) <= n:
        return s
    out, w = [], 0
    for ch in s:
        if w + _w(ch) > n - 1:
            break
        out.append(ch)
        w += _w(ch)
    return "".join(out) + "…" if n > 0 else ""


def pad(s, n):
    return s + " " * max(n - cells(s), 0)


def clip(line, n):
    """An ANSI line cut to `n` visible cells (escapes kept, so colours still close)."""
    if cells(line) <= n:
        return line
    out, w = [], 0
    for m in re.finditer(r"(\x1b\[[0-9;?]*[A-Za-z])|(.)", line, re.S):
        if m.group(1):
            out.append(m.group(1))
        elif w + _w(m.group(2)) <= n:
            out.append(m.group(2))
            w += _w(m.group(2))
        else:
            break
    return "".join(out) + OFF


# ---- data ----
def contexts():
    """sessionId -> its claude_sessions row (title, total spent, last usage), refreshed every CTX_EVERY seconds."""
    if time.time() - _rows["at"] > CTX_EVERY:
        try:
            _rows["by_id"] = {r["id"]: r for r in cs.build()}
        except Exception:
            pass                                          # keep the last good map; the panel must never die on this
        _rows["at"] = time.time()
    return _rows["by_id"]


def tmux_panes():
    """{pane_id: (session, window_index, pane_title, window_id)} of every tmux pane; {} when tmux does not answer."""
    fmt = SEP.join(["#{pane_id}", "#{session_name}", "#{window_index}", "#{pane_title}", "#{window_id}"])
    try:
        out = subprocess.run(["tmux", "list-panes", "-a", "-F", fmt], capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    return {p[0]: tuple(p[1:]) for p in (l.split(SEP) for l in out.splitlines()) if len(p) == 5}


def here(panes):
    """This panel's tmux session, from the pane list; None outside tmux."""
    return (panes.get(os.environ.get("TMUX_PANE") or "") or (None,))[0]


def last_of(d):
    return max(d.get("statusUpdatedAt") or 0, d.get("updatedAt") or 0, d.get("startedAt") or 0) / 1000


def sessions(panes, by_id, now):
    """One dict per running session id: {id, n (processes), label, title, status, last, ctx, spent}. ctx is
    cs.context() of this very moment, so the countdown never lags the CTX_EVERY rebuild."""
    group = {}
    for d in cs.registry():
        group.setdefault(d.get("sessionId") or f"pid {d.get('pid')}", []).append(d)
    me, out = here(panes), []
    for sid, ds in group.items():
        def pane_of(d):                                   # its pane, still in its window: ids repeat across tmux servers
            win, _, pane = (d.get("tmux") or "").rpartition(":")[2].partition(".")
            p = panes.get(pane)
            return p if p and p[3] == win else None
        d = max(ds, key=lambda d: (pane_of(d) is not None, last_of(d)))     # the one in a tmux window, else the latest
        pane, row = pane_of(d), by_id.get(sid) or {}
        live = {"tmux_session": pane[0] if pane else None, "window_index": pane[1] if pane else None, "kind": d.get("kind")}
        title = re.sub(r"^[^\w(]\s+", "", pane[2]).strip() if pane else ""
        out.append({"id": sid, "n": len(ds), "label": cs.live_label({"live": live}, me),
                    "where": f"{pane[0]}:w{pane[1]}" if pane else cs.live_label({"live": live}, me),   # for messages: any client
                    "title": title or row.get("title") or (f"({d['entrypoint']}) " if d.get("entrypoint") else "")
                    + (d.get("name") or Path(d.get("cwd") or "").name or sid[:8]),
                    "status": "busy" if any(x.get("status") == "busy" for x in ds) else d.get("status") or "?",
                    "last": max(map(last_of, ds)), "ctx": cs.context(row or {"id": sid, "usage": None}, now),
                    "spent": row.get("spent")})
    return out


def order(x):
    """Busy first, then warm (least time left first), then cold by cost to wake (dearest first), then no context yet."""
    c = x["ctx"]
    if x["status"] == "busy":
        return (0, -x["last"])
    if c and c["warm"]:
        return (1, c["left"])
    return (2, -c["wake"]) if c else (3, -x["last"])


def nudge_minutes():
    return cs.setting_num("NUDGE_MIN", 10, float)


def hurry(x, minutes, big=True):
    """Idle and warm for less than `minutes` more (yellow minutes); with `big` also past CTX_WARN_K (the nudge)."""
    c = x["ctx"]
    return bool(c and c["warm"] and x["status"] != "busy" and c["left"] < minutes * 60 and (c["tokens"] >= cs.CTX_WARN or not big))


# ---- the frame ----
def cells_of(x, now):
    c = x["ctx"]
    size, price, left, spent = cs.ctx_cells({"ctx": c, "spent": x["spent"]})
    return {"ctx": size, "step": cs.money(c["step"]) if c else "", "warm": (left if c["warm"] else price) if c else "",
            "spent": spent, "used": dashlib.dur(now - x["last"]) if x["last"] else ""}


def title_line(items, width, tint):
    n = len(items)
    busy = sum(1 for x in items if x["status"] == "busy")
    warm = sum(1 for x in items if x["ctx"] and x["ctx"]["warm"])
    big = sum(1 for x in items if x["ctx"] and x["ctx"]["level"] == 2)
    pieces = [(rank, t) for rank, k, t in ((3, busy, f"{busy} busy"), (1, warm, f"{tint}{warm} warm{OFF}"),
                                                 (4, big, f"{RED}{big} over {cs.CTX_CLEAR // 1000}K{OFF}")) if k]
    while True:
        line = f" {BOLD}{n} Claude session{'s' * (n != 1)}{OFF}" + "".join(f"{GREY} · {OFF}{t}" for _, t in pieces)
        if cells(line) <= width or not pieces:
            return clip(line, width)
        pieces.remove(min(pieces))                       # the least important piece goes first


def legend(spare, width, tint, text):
    """The legend for `spare` free rows: none, one line, or the long one with the restore snapshot."""
    if spare <= 0:
        return []
    dot = lambda s, word: f"{DOT[s]}●{OFF}{GREY} {word}"
    one = f" {dot('busy', 'busy')} {dot('idle', 'idle')} {dot('shell', 'shell')} · ↻$ = cold, cost to wake{OFF}"
    if spare == 1:
        return [clip(one, width)]
    dots = f" {dot('busy', 'busy')}  {dot('idle', 'idle')}  {dot('shell', 'idle, background shell open')}{OFF}"
    cost = f" {tint}$.05{OFF}{GREY}/step · {text}42m{OFF}{GREY} warm left · ↻$2.4 = cold, cost to wake{OFF}"
    out = [dots, cost]
    if spare >= 3:
        out.insert(0, "")
    if spare >= 4 and SNAPSHOT.exists():
        try:
            age = time.time() - SNAPSHOT.stat().st_mtime
            n = SNAPSHOT.read_text().count("claude --resume")
            out.append(f"{GREY} restore snapshot: {n} sessions, {dashlib.dur(age)} ago (tmux-claude-save){OFF}")
        except OSError:
            pass
    return [clip(l, width) for l in out]


def render():
    cols, height = shutil.get_terminal_size()
    width, now, text = cols - 1, time.time(), warm_tint()      # never the last column: no pending wrap, no scroll
    tint = BOLD + text
    items = sorted(sessions(tmux_panes(), contexts(), now), key=order)
    out = [title_line(items, width, tint)]
    header = height >= 5
    avail = height - 1 - header
    if len(items) <= avail:
        shown, hidden = items, []
    else:
        shown, hidden = items[:max(avail - 1, 0)], items[max(avail - 1, 0):]
    cell = [cells_of(x, now) for x in shown]
    lab = max([cells(x["label"]) for x in shown] + [1])
    cols_on = list(COLUMNS)
    w = {k: max([len(k)] + [cells(c[k]) for c in cell]) for k in COLUMNS}
    title_w = lambda: width - (lab + 4) - sum(1 + w[k] for k in cols_on)
    for k in DROP:
        if title_w() < MIN_TITLE:
            cols_on.remove(k)
    tw = max(title_w(), 4)
    if not items and height > 1:
        out.append(f"{GREY} none running{OFF}")
    elif header and avail > 0:
        out.append(clip(f"{GREY} {'':>{lab}}   {'':<{tw}}" + "".join(f" {k:>{w[k]}}" for k in cols_on) + OFF, width))
    minutes = nudge_minutes() or 10
    for x, c in zip(shown, cell):
        ctx = x["ctx"] or {}
        twice = f"{RED}×{x['n']}{OFF} " if x["n"] > 1 else ""
        title = pad(cut(x["title"], tw - cells(twice)), tw - cells(twice))
        tint_step = tint if ctx.get("warm") else ""
        tint_warm = (LEVEL[1] if hurry(x, minutes, big=False) else text) if ctx.get("warm") else ""
        style = {"ctx": LEVEL.get(ctx.get("level"), ""), "step": tint_step, "warm": tint_warm, "spent": "", "used": GREY}
        line = (f" {x['label']:>{lab}} {DOT.get(x['status'], '')}{'●' if x['status'] in DOT else '○'}{OFF} {twice}{title}"
                + "".join(f" {' ' * (w[k] - cells(c[k]))}{style[k]}{c[k]}{OFF}" for k in cols_on))
        out.append(clip(line, width))
    if hidden:
        big = sum(1 for x in hidden if x["ctx"] and x["ctx"]["level"] == 2)
        more = f"{GREY} … {len(hidden)} more" + (f" · {OFF}{RED}{big} over {cs.CTX_CLEAR // 1000}K{OFF}{GREY} hidden" if big else "")
        out.append(clip(more + OFF if cells(more) <= width else more.removesuffix(" hidden") + OFF, width))
    else:
        out += legend(height - len(out), width, tint, text)
    out = out[:max(height, 1)]
    return "\033[H" + "\033[K\n".join(out) + "\033[K\033[J"


# ---- cache-expiry nudge ----
def _tmux(*args):
    try:
        return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def tell(text, ms=10000):
    """Show `text` for `ms` on every client of this tmux server - not only those on this dashboard's session: the marker
    lets one dashboard through, and you may be looking at the other one. How many clients got it."""
    clients = [c for c in _tmux("list-clients", "-F", "#{client_name}").splitlines() if c]
    for c in clients:
        _tmux("display-message", "-d", str(ms), "-c", c, text.replace("#", "##").replace("%", "%%"))   # no formats, no strftime
    return len(clients)


def claim(path):
    """True for the one process that creates marker `path` first (every dashboard runs this panel)."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        os.close(os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644))
        return True
    except OSError:
        return False


def tidy(now):
    """Markers of expiries more than a day old go, at most once an hour."""
    if now - _tidied[0] < 3600:
        return
    _tidied[0] = now
    try:
        for f in NUDGED.iterdir():
            exp = f.name.rpartition("-")[2]
            if exp.isdigit() and int(exp) < now - 86400:
                f.unlink()
    except OSError:
        pass


def nudge(now=None):
    """One check: registry + status snapshots only (cs.context), tmux only when a session is due. The messages sent."""
    minutes = nudge_minutes()
    if minutes <= 0 or not os.environ.get("TMUX_PANE"):
        return []
    now = now or time.time()
    by_id, busy, due = _rows["by_id"], set(), set()
    for d in cs.registry():
        sid = d.get("sessionId")
        if d.get("status") == "busy":
            busy.add(sid)
        c = cs.context(by_id.get(sid) or {"id": sid, "usage": None}, now) if sid else None
        if c and c["warm"] and c["tokens"] >= cs.CTX_WARN and c["left"] < minutes * 60:
            due.add(sid)
    due -= busy
    tidy(now)
    if not due:
        return []
    panes = tmux_panes()
    if not _tmux("list-clients", "-F", "#{client_name}").strip():
        return []                                         # nobody attached anywhere: keep it until someone is
    sent = []
    for x in sessions(panes, by_id, now):
        c = x["ctx"]
        if x["id"] not in due or not hurry(x, minutes) or not claim(NUDGED / f"{x['id']}-{round(now + c['left'])}"):
            continue
        size = cs.ctx_label(c).split()[0]
        text = (f"{x['where']} {cut(x['title'], 40)}: cache goes cold in {dashlib.dur(c['left'])} "
                f"({size}, ↻{cs.money(c['wake'])} to wake) - continue it or /handoff")
        tell(text)
        sent.append(text)
    return sent


def nudger():
    while True:
        dashlib.safe(nudge)                               # an error is logged once, never ends the thread
        time.sleep(NUDGE_EVERY)


def main():
    if "--once" in sys.argv:                              # one frame, no nudges
        sys.stdout.write(render())
        return
    threading.Thread(target=nudger, daemon=True).start()
    screen, drawing = dashlib.Screen(), threading.Lock()

    def draw(*_):
        if drawing.acquire(blocking=False):               # SIGWINCH can land mid-frame
            try:
                screen.show(dashlib.safe(render))
            finally:
                drawing.release()

    sys.stdout.write("\033[?25l\033[2J")
    signal.signal(signal.SIGWINCH, draw)                  # redraw on a layout change, not at the next tick
    try:
        while True:
            draw()
            if dashlib.wait(FRAME_EVERY):                 # back from hidden: rebuild before drawing
                _rows["at"] = 0
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[?25h\n")


if __name__ == "__main__":
    main()
