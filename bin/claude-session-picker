#!/usr/bin/env python3
"""Keyboard-only browser of every Claude Code session, for the tmux `sessions` window.

Type to filter: every word must match the title, folder, id, prompts, handoff note or date. Tokens narrow it further,
and tokens and words all combine with AND:
  is:open is:warm is:cold is:running is:idle is:orphan     block:Exp   block name prefix (also the block before Open)
  >400k <100k   context tokens over / under (k, m or none)  $>5 $<1     spent at API prices over / under, in dollars
Enter resumes the highlighted session in a new tmux window in its own folder; if it is already running, Enter jumps to
that window instead (only inside its own tmux session: a dashboard never switches your terminal to another tmux
session), so a conversation is never resumed twice: Enter, n and r read the running state and continued.json again just
before they act, not from the last refresh (up to 10 s old).

Looks like the dashboard: the window carries the same MAGI tint (dash-theme style) and the same coloured dots.
Built to survive stray input, like the dash window: the mouse does nothing, Ctrl-C/Z/D are swallowed and there is no
quit key (the pane-died hook respawns it if it ever dies).

  type        filter            Esc / Ctrl-U   clear filter        Tab    all / idle / running
  Up Down     move (Ctrl-P/N)   PgUp PgDn      page                Ctrl-O show stubs + empty ones
  Enter       resume or jump    Ctrl-Y         copy resume cmd     Ctrl-R refresh now
  Ctrl-S      sort within blocks: recent (default) / spent / context size / wake cost - remembered in picker.state
  Ctrl-V      read the thread's handoff note in a tmux popup (its digest when there is only a parked stub or no note)
  ?           every key and filter token (when the filter is empty; Ctrl-/ or F1 any time) - any key closes it
  Ctrl-K      end the running session completely (asks first: y, or Y when it is busy; the transcript is kept)
  Ctrl-X      mark the thread's handoff note done (or open again)
  Ctrl-T      park it: a stub note (open, next = your last prompt) and a transcript digest, made here; then PARK_MODEL
              (default haiku, under $.01; off = keep the stub) rewrites the stub from the digest in the background
  Left Right  jump to the previous / next block   Enter on a header  fold / unfold it   Ctrl-G  by block / flat list
Threads: /handoff (~/.claude/skills/handoff) writes ~/.claude/handoffs/<sessionId>.md; while its status is open the
session sits in the Open block at the top, whatever its folder - oldest note first (in the recent sort), each row with
its note's age, yellow when the note was not updated for STALE_DAYS (7) days. Enter on an idle session that has a note,
or is big (CTX_WARN_K) and cold, asks first: n = a new session in the same folder that starts from the note - or,
without one, from a digest of the transcript made here for free (no API call) - started with --session-id so the old
one folds under it, and with --model set to the old session's model; r = resume as is. An open note whose transcript
Claude Code purged (cleanupPeriodDays) stays in Open as "transcript gone": Enter then n is all it offers.
Blocks are made automatically from the experiment code of the session's folder (Exp011530 -> Exp, Gen022830 -> Gen,
Cyt..., Seq...), or of a code named in its title; sessions started in the home folder go to ~, the rest to Other.
Order: SESSION_BLOCK_ORDER in ~/.config/tmux-dashboard/config (default Gen,Cyt,Seq,Exp), new codes after those.
Columns ctx / step / warm / spent: '312K $.06' = every step of the session re-sends 312 thousand tokens, 6 cents per
step while the cache is warm, for `warm` (59m, 1h00) more; '312K ↻$2.5' = the cache went cold and the first step after
resuming rewrites it all for $2.50; spent = the session so far, at API prices. Money is right-aligned, at most 5 cells.
Colours, as in the sessions panel: the price of a warm cache in the theme's second colour, bold (cold is plain text);
the context yellow from CTX_WARN_K (200) thousand tokens - /compact soon - and bright red from CTX_CLEAR_K (400) -
/clear or /compact now; the running dot green when idle, white when busy; secondary text grey.

CLAUDE_BIN (default `claude`) is what is typed into the new window - tests set it to `echo`; CLAUDE_PICKER_STATE moves
picker.state (tests). The list is rebuilt every REFRESH_S seconds while a tmux client (or the web mirror) shows this
window, and at once when it comes back on screen; keys act instantly either way.
"""
import curses, json, os, re, shlex, signal, subprocess, sys, time, traceback, unicodedata, uuid
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import claude_sessions as cs
import dashlib

os.environ.setdefault("ESCDELAY", "25")
CLAUDE_BIN = os.environ.get("CLAUDE_BIN", "claude")
REFRESH_S = 10
VISIBLE_EVERY = 2                            # s between dashlib.visible() checks (it shares one tmux call across panels)
STALE_DAYS = 7                               # an open note not updated for this long is flagged yellow
LINK_GRACE = 120                             # s: a continuation started here counts as existing before it has a transcript
RESUME_GRACE = 30                            # s: a session resumed here counts as running before it registers
MODES = ("all", "idle", "running")
SORTS = ("recent", "spent", "context", "wake")
ERRLOG = Path.home() / ".claude" / "dash" / "picker.err"
DEFAULT_COLLAPSED = {"Auto"}                 # blocks that start folded until you open them once
BLOCK_NOTES = {"Auto": "runs started by scripts, benchmarks or the SDK (claude -p) - not by you in a terminal",
               "Open": "threads with an open /handoff note, oldest note first - Enter continues one, Ctrl-X marks it done"}
STATE = Path(os.environ.get("CLAUDE_PICKER_STATE") or Path.home() / ".claude" / "dash" / "picker.state")  # grouped, collapsed, sort
CTRL = re.compile(r"[\x00-\x1f\x7f-\x9f]")    # never drawn: curses would expand a tab or act on an escape

# Filter tokens (see the docstring). A token still being typed ("is:ru", "$>") filters nothing yet.
IS = {"open": lambda r: r["block"] == "Open", "warm": lambda r: bool(r["ctx"] and r["ctx"]["warm"]),
      "cold": lambda r: bool(r["ctx"] and not r["ctx"]["warm"]), "running": lambda r: bool(r["live"]),
      "idle": lambda r: not r["live"], "orphan": lambda r: bool(r.get("orphan"))}
TOKENS_RE = re.compile(r"([<>])(\d*\.?\d+)([km]?)")
SPENT_RE = re.compile(r"\$([<>])(\d*\.?\d+)")


def tmux(*args):
    r = subprocess.run(["tmux", *args], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(r.stderr.strip() or f"tmux {args[0]} failed")
    return r.stdout.strip()


def my_session():
    """This pane's tmux session, asked each time: `tmux rename-session` must not leave the browser on a stale name."""
    try:
        return tmux("display-message", "-p", "-t", os.environ.get("TMUX_PANE", ""), "#{session_name}")
    except RuntimeError:
        return None


def resume_cmd(r):
    return f"{CLAUDE_BIN} --resume {r['id']}"


def tilde(p):
    p, home = str(p or ""), str(Path.home())
    return "~" + p[len(home):] if p == home or p.startswith(home + "/") else p


def open_row(r, sess):
    """Resume in a new window, or jump to the running one. `r` carries live state read just now. Returns the status line."""
    if r.get("orphan"):
        return "transcript gone - nothing to resume; Enter then n starts a new session from the note"
    lv = r["live"]
    if lv:
        if lv["window_id"]:
            if lv["tmux_session"] != sess:       # a dashboard stays in its own tmux session: no switch-client, no select-window there
                return (f"running in tmux session '{lv['tmux_session']}' (window {lv['window_index']}) - "
                        f"not jumping across tmux sessions; open it from that session")
            tmux("select-window", "-t", lv["window_id"])
            return f"already running - jumped to window {lv['window_index']}"
        return f"already running outside tmux ({cs.live_label(r)}) - not opening a second copy"
    n, note = launch(r["cwd"], resume_cmd(r), sess)
    return f"resuming in window {n}{note}"


def launch(cwd, cmd, sess):
    """Type `cmd` into a new window of this tmux session, opened in `cwd`. Returns (window number, note)."""
    if not sess:
        raise RuntimeError("cannot tell which tmux session this browser is in")
    note = ""
    if not cwd or not os.path.isdir(cwd):
        cwd, note = str(Path.home()), " (original folder is gone - opened in ~, resume may not find it)"
    top = max(int(i) for i in tmux("list-windows", "-t", f"={sess}", "-F", "#{window_index}").split())
    wid = tmux("new-window", "-P", "-F", "#{window_id}", "-t", f"={sess}:{top + 1}", "-c", cwd.replace("#", "##"))   # -c is a format
    tmux("send-keys", "-t", wid, "-l", cmd)
    tmux("send-keys", "-t", wid, "Enter")
    return top + 1, note


def continue_cmd(r, new):
    """The command that starts session `new` on `r`'s thread (the prompt: cs.continue_prompt - its note, else a digest)."""
    model = (r["ctx"] or {}).get("model")          # the old session's model, so a Sonnet thread does not move to the default
    flag = f"--model {shlex.quote(model)} " if model else ""
    return (f"{CLAUDE_BIN} --session-id {new} {flag}-n {shlex.quote(fit(r['title'], 48) + ' (cont.)')} "
            f"{shlex.quote(cs.continue_prompt(r))}")


def continue_row(r, sess, new):
    """Session `new` on `r`'s thread, in a new window; the old session is linked to it and folds away. Returns the status line."""
    n, note = launch(r["cwd"], continue_cmd(r, new), sess)
    cs.add_link(r["id"], new)
    return f"continuing {r['short']} as {new[:8]} in window {n}{note} - the old session folds under it (Ctrl-O shows it)"


def end_session(r):
    """End a running session completely. The transcript is never touched, so it can be resumed again. Returns the status line."""
    lv = r["live"]
    if "back" in (lv["kind"] or "") or lv["kind"] == "bg":      # a background session is stopped through the CLI
        out = subprocess.run([*shlex.split(CLAUDE_BIN), "stop", r["short"]], capture_output=True, text=True)
        return (out.stdout or out.stderr).strip() or f"asked claude to stop {r['short']}"
    pid = lv["pid"]
    try:
        os.kill(pid, signal.SIGTERM)                              # a polite exit first: lets Claude finish its transcript
    except ProcessLookupError:
        pass
    for _ in range(40):
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            break
        time.sleep(0.1)
    else:
        os.kill(pid, signal.SIGKILL)                              # still there after 4 s
    if lv["pane_id"]:
        subprocess.run(["tmux", "kill-pane", "-t", lv["pane_id"]], capture_output=True)   # closes its window when it was the last pane
    return f"ended {r['short']} {'and closed its window' if lv['pane_id'] else '(outside tmux: only the process)'} - transcript kept, Enter on it resumes"


def copy_text(text):
    subprocess.run(["pbcopy"], input=text, text=True)


def _w(ch):
    """Display width of one character: 2 for wide (CJK, emoji), 0 for combining marks, else 1."""
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def cells(s):
    return sum(_w(c) for c in s)


def fit(s, n):
    """Truncate to n display cells (not characters), with an ellipsis. Control characters become spaces."""
    s = CTRL.sub(" ", s or "")
    if n <= 0:
        return ""
    if cells(s) <= n:
        return s
    out, used = [], 0
    for ch in s:
        if used + _w(ch) > n - 1:
            break
        out.append(ch)
        used += _w(ch)
    return "".join(out) + "…"


def fit_tail(s, n):
    """Like fit(), but keeps the end: a long path shows its last folders."""
    s = CTRL.sub(" ", s or "")
    if cells(s) <= n:
        return s
    out, used = [], 0
    for ch in reversed(s):
        if used + _w(ch) > n - 1:
            break
        out.append(ch)
        used += _w(ch)
    return "…" + "".join(reversed(out))


def pad(s, n):
    """Pad to n display cells."""
    return s + " " * max(0, n - cells(s))


def nearest256(hexcode):
    """The xterm-256 colour nearest to '#rrggbb': the 6x6x6 cube or the grey ramp."""
    rgb = [int(hexcode.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)]
    levels = (0, 95, 135, 175, 215, 255)
    q = [min(range(6), key=lambda i: abs(levels[i] - v)) for v in rgb]
    g = max(0, min(23, round((sum(rgb) / 3 - 8) / 10)))
    dist = lambda c: sum((a - b) ** 2 for a, b in zip(c, rgb))
    return 16 + 36 * q[0] + 6 * q[1] + q[2] if dist([levels[i] for i in q]) <= dist([8 + 10 * g] * 3) else 232 + g


def layout(W):
    """x of each column for a window W cells wide. Below 110 columns the created date and id go (the rule line above the
    preview names both), below 76 the folder; the title takes the rest."""
    x, cols = 1, {}
    wide = (("date", 5), ("id", 8)) if W >= 110 else ()
    for name, w in (("lab", 6), ("dot", 1), ("ago", 4)) + wide + (("size", 5), ("price", 6), ("left", 4), ("spent", 5)):
        cols[name] = x
        x += w + 1
    fw = 20 if W >= 160 else 16 if W >= 120 else 12 if W >= 76 else 0
    cols.update(title=x, fw=fw, tw=max(10, W - 1 - x - (fw + 1 if fw else 0)))
    return cols


def parse_filter(text):
    """(tests, words): the filter's tokens as predicates on a row, and the plain words left for cs.matches()."""
    tests, words = [], []
    for w in text.lower().split():
        if w.startswith("is:"):
            v = w[3:]
            if v in IS:
                tests.append(IS[v])
                continue
            if any(k.startswith(v) for k in IS):          # still typing it
                continue
        elif w.startswith("block:"):
            v = w[6:]
            tests.append(lambda r, v=v: r["block"].lower().startswith(v) or (r.get("home_block") or "").lower().startswith(v))
            continue
        elif m := TOKENS_RE.fullmatch(w):
            lim = float(m.group(2)) * {"": 1, "k": 1e3, "m": 1e6}[m.group(3)]
            tests.append(lambda r, gt=m.group(1) == ">", lim=lim:
                         bool(r["ctx"]) and (r["ctx"]["tokens"] > lim if gt else r["ctx"]["tokens"] < lim))
            continue
        elif m := SPENT_RE.fullmatch(w):
            tests.append(lambda r, gt=m.group(1) == ">", lim=float(m.group(2)):
                         (r.get("spent") or 0) > lim if gt else (r.get("spent") or 0) < lim)
            continue
        elif re.fullmatch(r"\$?[<>]?\.?", w):            # a token half typed: $  $>  >  >.  $<.
            continue
        words.append(w)
    return tests, words


def sort_key(name):
    return {"spent": lambda r: r.get("spent") or 0, "context": lambda r: (r["ctx"] or {}).get("tokens") or 0,
            "wake": lambda r: (r["ctx"] or {}).get("wake") or 0}[name]


HELP = [  # (text, style); every line fits 79 cells
    ("Session browser - every key                              any key closes this", "bold"),
    ("Enter      resume in a new window, or jump to its window when it runs here;", ""),
    ("           with a note, or big and cold: n = new session from the note (or a", ""),
    ("           free digest), r = resume as is; transcript gone: n only", ""),
    ("Up Down    move (Ctrl-P Ctrl-N)   PgUp PgDn  page    Home End  first / last", ""),
    ("Left Right previous / next block  Enter on a block header  fold / unfold", ""),
    ("type       filter    Backspace  delete    Esc Ctrl-U  clear the filter", ""),
    ("Tab        all / idle / running   Ctrl-G  blocks / flat   Ctrl-O  stubs+empty", ""),
    ("Ctrl-S     sort within blocks: recent / spent / context / wake cost", ""),
    ("Ctrl-V     read the note (digest for a stub / no note) in a popup; q closes", ""),
    ("Ctrl-T     park: stub note + digest made here, the session is not woken", ""),
    ("Ctrl-X     mark the note done / open again", ""),
    ("Ctrl-K     end a running session (asks: y, or Y when busy; transcript kept)", ""),
    ("Ctrl-Y     copy the resume command    Ctrl-R  refresh now", ""),
    ("?          this help, when the filter is empty (Ctrl-/ or F1 at any time)", ""),
    ("Filter tokens - all combine with the words (AND)", "bold"),
    ("is:open is:warm is:cold is:running is:idle is:orphan", ""),
    (">400k <100k  context tokens over / under    block:Exp  block name prefix", ""),
    ("$>5 $<1      spent at API prices over / under, in dollars", ""),
