class Picker:
    def __init__(self, scr):
        self.scr = scr
        self.sess = my_session()                 # for labels only; every action asks tmux again (rename-session)
        self.rows, self.items, self.all_rows = [], [], []
        self.filter, self.mode, self.show_hidden, self.sort = "", 0, False, 0
        self.grouped, self.collapsed, self.expanded = True, set(), set()
        self.load_state()
        self.sel_key, self.sel, self.top, self.force_first = None, 0, 0, False
        self.msg, self.msg_until, self.last_refresh = "", 0, 0
        self.confirm = None                      # a question on the last line: {"keys": {key: action}, "prompt", "until"}
        self.help = False                        # the key help overlay
        self.launched = {}                       # session id -> when n started it here (it has no transcript yet)
        self.seen, self.seen_at = True, 0        # dashlib.visible(), and when it was last asked
        self.second = None
        curses.curs_set(0)
        curses.use_default_colors()
        self.colours()
        scr.keypad(True)
        scr.timeout(1000)
        self.refresh()

    def colours(self):
        """Colour pairs, the same meanings as the sessions panel. Re-read on refresh: dash-theme can switch the theme."""
        second = dashlib.theme_hex("second")
        if second == self.second and self.second is not None:
            return
        self.second = second
        many = curses.COLORS >= 256
        try:
            warm = nearest256(second) if many and second else curses.COLOR_CYAN
        except (ValueError, TypeError):
            warm = curses.COLOR_CYAN
        curses.init_pair(1, curses.COLOR_GREEN, -1)                       # idle dot
        curses.init_pair(2, curses.COLOR_YELLOW, -1)                      # a threshold: context, a stale note, minutes running out
        curses.init_pair(3, 196 if many else curses.COLOR_RED, -1)        # context past CTX_CLEAR_K: bright red
        curses.init_pair(4, warm, -1)                                     # cache warm: the theme's second colour (#3cffd0 -> 86)
        curses.init_pair(5, 245 if many else curses.COLOR_WHITE, -1)      # secondary text: grey (A_DIM is ~2.3:1 on MAGI orange)
        curses.init_pair(6, 231 if many else curses.COLOR_WHITE, -1)      # busy dot: white
        P, B = curses.color_pair, curses.A_BOLD
        self.A = {None: 0, "idle": P(1), "warn": P(2) | B, "clear": P(3) | B, "warm": P(4) | B, "warmtext": P(4),
                  "grey": P(5), "busy": P(6) | B, "bold": B}

    # ---- state that survives a restart: grouped or flat, which blocks are collapsed, the sort ----
    def state(self):
        return {"grouped": self.grouped, "collapsed": sorted(self.collapsed), "expanded": sorted(self.expanded),
                "sort": SORTS[self.sort]}

    def load_state(self):
        self.saved = self.state()                # as last read or written (the defaults without a file): save_state()
        try:                                     # writes only what changed here since
            d = json.loads(STATE.read_text())
            self.grouped, self.collapsed, self.expanded = bool(d.get("grouped", True)), set(d.get("collapsed", [])), set(d.get("expanded", []))
            self.sort = SORTS.index(d["sort"]) if d.get("sort") in SORTS else 0
        except (OSError, ValueError, AttributeError, TypeError):
            return
        self.saved = self.state()

    def save_state(self):
        """Write back only what changed in this picker since it last loaded or saved; the rest comes from the file, which
        the other dashboard's picker writes too - so a fold there does not undo a sort change here."""
        mine = self.state()
        try:
            disk = json.loads(STATE.read_text())
            disk = disk if isinstance(disk, dict) else {}
        except (OSError, ValueError):
            disk = {}
        out = {}
        for k, v in mine.items():
            was = self.saved.get(k, v)
            if k in ("collapsed", "expanded"):           # per block: what was folded / unfolded here, on top of the file
                d = set(disk[k]) if isinstance(disk.get(k), list) else set(was)
                out[k] = sorted((d - (set(was) - set(v))) | (set(v) - set(was)))
            else:
                out[k] = v if v != was or k not in disk else disk[k]
        try:
            STATE.parent.mkdir(parents=True, exist_ok=True)
            tmp = STATE.with_suffix(f".{os.getpid()}.tmp")
            tmp.write_text(json.dumps(out))
            os.replace(tmp, STATE)
        except OSError:
            return
        self.saved = out
        self.grouped, self.collapsed, self.expanded = bool(out["grouped"]), set(out["collapsed"]), set(out["expanded"])
        self.sort = SORTS.index(out["sort"]) if out["sort"] in SORTS else self.sort

    # ---- data ----
    def refresh(self):
        self.all_rows = cs.build()
        self.last_refresh = time.time()
        self.sess = my_session() or self.sess
        self.colours()
        self.apply_filter()

    def fresh(self, r):
        """`r` with its running state and continuation read now, not at the last refresh: a session resumed elsewhere, or
        continued by an earlier n, in the meantime is not opened a second time. r["cont"] = the session it was continued
        as, when that one exists: running, with a transcript, or started here in the last LINK_GRACE s (a link to a
        session that never started does not block a new one)."""
        live = cs.live_map()
        new = cs.links().get(r["id"]) or r.get("continued_by")
        if new and not (new in live or time.time() - self.launched.get(new, 0) < LINK_GRACE
                        or any(cs.PROJECTS.glob(f"*/{new}.jsonl"))):
            new = None
        return dict(r, live=None if r.get("orphan") else live.get(r["id"]), cont=new, cont_live=live.get(new) if new else None)

    def sorted_rows(self, rows, block=None):
        s = SORTS[self.sort]
        if s == "recent":                        # build() order is newest use first; Open: oldest note first, stale threads surface
            if block == "Open":
                return sorted(rows, key=lambda r: (r["handoff"] or {}).get("updated") or r["last"])
            return rows
        return sorted(rows, key=sort_key(s), reverse=True)

    def build_items(self):
        """What the list shows: session rows, under one header per block when grouped."""
        if not self.grouped:
            return [{"t": "row", "r": r} for r in self.sorted_rows(self.rows)]
        by = {}
        for r in self.rows:
            by.setdefault(r["block"], []).append(r)
        items = []
        for b in cs.block_order(self.rows):
            collapsed = self.is_collapsed(b) and not self.filter      # a search always opens the blocks
            rows = self.sorted_rows(by[b], b)
            items.append({"t": "hdr", "b": b, "rows": rows, "collapsed": collapsed})
            if not collapsed:
                items += [{"t": "row", "r": r} for r in rows]
        return items

    @staticmethod
    def key_of(it):
        return ("hdr", it["b"]) if it["t"] == "hdr" else ("row", it["r"]["id"])

    def apply_filter(self):
        tests, words = parse_filter(self.filter)
        rows = self.all_rows
        if not self.show_hidden:
            rows = [r for r in rows if not (r["folded"] or r["empty"])]
        if MODES[self.mode] == "idle":
            rows = [r for r in rows if not r["live"]]
        elif MODES[self.mode] == "running":
            rows = [r for r in rows if r["live"]]
        self.rows = [r for r in rows if cs.matches(r, words) and all(t(r) for t in tests)]
        self.items = self.build_items()
        keys = [self.key_of(it) for it in self.items]
        if self.force_first:                     # the filter just changed: the first match is what Enter should act on
            self.force_first = False
            self.sel = next((n for n, it in enumerate(self.items) if it["t"] == "row"), 0)
        elif self.sel_key in keys:
            self.sel = keys.index(self.sel_key)
        self.remember()

    def remember(self):
        self.sel = max(0, min(self.sel, len(self.items) - 1))
        self.sel_key = self.key_of(self.items[self.sel]) if self.items else None

    def cur(self):
        return self.items[self.sel] if self.items else None

    def cur_row(self):
        it = self.cur()
        return it["r"] if it and it["t"] == "row" else None

    def say(self, text, secs=5):
        self.msg, self.msg_until = text, time.time() + secs

    @staticmethod
    def asks(r):
        """Enter asks n / r first: there is a note to start from, or waking it would be dear."""
        c = r["ctx"]
        return bool(r.get("orphan") or r["handoff"] or (c and not c["warm"] and c["level"]))

    # ---- drawing ----
    def put(self, y, x, s, attr=0, width=None):
        """Draw `s` at (y, x), cut by display cells to `width` and to the last column but one - a wide (CJK, emoji)
        character never pushes text past the edge, and nothing lands in the bottom-right cell, where curses raises ERR.
        Returns the x after it."""
        H, W = self.scr.getmaxyx()
        room = W - 1 - x
        if not 0 <= y < H or room <= 0:
            return x
        s = fit(s, room if width is None else min(width, room))
        try:
            self.scr.addstr(y, x, s, attr)
        except curses.error:                     # a character the terminal sizes differently: lose a cell, not the browser
            pass
        return x + cells(s)

    def puts(self, y, x, segs, width=None):
        """Draw [(text, attr), ...] one after another from x, within `width` cells."""
        end = (self.scr.getmaxyx()[1] - 1) if width is None else x + width
        for text, attr in segs:
            if x >= end:
                break
            x = self.put(y, x, text, attr, end - x)
        return x

    def draw(self):
        scr = self.scr
        scr.erase()
        H, W = scr.getmaxyx()
        if H < 12 or W < 60:
            self.put(0, 0, "window too small for the session browser")
            scr.refresh()
            return
        if self.help:
            self.draw_help(H, W)
            scr.refresh()
            return
        L = layout(W)
        list_h = H - 2 - 8                       # title + filter on top; rule, 6 preview lines and the hint at the bottom
        self.sel = max(0, min(self.sel, len(self.items) - 1))
        if self.sel < self.top:
            self.top = self.sel
        if self.sel >= self.top + list_h:
            self.top = self.sel - list_h + 1
        self.top = max(0, min(self.top, len(self.items) - list_h))
        now = time.time()
        self.draw_head(W)
        self.draw_filter_line(L, W)
        for i in range(list_h):
            k = self.top + i
            if k >= len(self.items):
                break
            it = self.items[k]
            if it["t"] == "hdr":
                self.draw_header(2 + i, it, W, k == self.sel, now)
            else:
                self.draw_row(2 + i, it["r"], L, W, now, k == self.sel)
        if not self.items:
            self.put(3, 2, "no session matches", self.A["grey"])
        self.draw_preview(H - 8, W, now)
        self.draw_bottom(H, W)
        scr.refresh()

    def draw_head(self, W):
        n_hidden = sum(1 for r in self.all_rows if r["folded"] or r["empty"])
        n_big = sum(1 for r in self.all_rows if r["live"] and r["ctx"] and r["ctx"]["level"] == 2)
        head = f" Claude sessions  {len(self.rows)} shown  [{MODES[self.mode]}]  {'by block' if self.grouped else 'flat'}"
        k = cs.CTX_CLEAR // 1000
        w0, w1 = (f"{n_big} running over {k}K: /clear or /compact", f"{n_big} running >{k}K") if n_big else (None, None)
        h0, h1 = (("+stubs", "+stubs") if self.show_hidden else
                  (f"({n_hidden} stubs/empty hidden: Ctrl-O)", f"(+{n_hidden} hidden)") if n_hidden else (None, None))
        # the warning outranks the stubs hint: the hint shrinks and goes before the warning does
        for w, h in ((w0, h0), (w0, h1), (w0, None), (w1, h1), (w1, None), (None, h1), (None, None)):
            if cells(head) + sum(cells(t) + 2 for t in (w, h) if t) <= W - 1:
                break
        x = self.put(0, 0, head, curses.A_BOLD)
        if w:
            x = self.put(0, x + 2, w, self.A["clear"])
        if h:
            self.put(0, x + 2, h, self.A["grey"])

    def draw_filter_line(self, L, W):
        """Line 1: the sort on the left, the column titles over their columns, the filter over the titles."""
        sort = SORTS[self.sort]
        label = (f" sort: {sort}" + ("  (Ctrl-S)" if L["size"] > 24 else "")) if "id" in L else f" sort:{sort}"
        self.put(1, 0, label, self.A["grey"] if sort == "recent" else curses.A_BOLD, L["size"] - 1)
        g = self.A["grey"]
        self.put(1, L["size"], f"{'ctx':>5}", g)
        self.put(1, L["price"], f"{'step':>6}", g)
        self.put(1, L["left"], f"{'warm':>4}", g)
        self.put(1, L["spent"], f"{'spent':>5}", g)
        room = W - 1 - L["title"]
        if self.filter:
            shown = f"filter: {self.filter}▏"
            if cells(shown) > room:              # a long filter shows its end, where you type
                text = self.filter
                while text and cells(f"filter: …{text}▏") > room:
                    text = text[1:]
                shown = f"filter: …{text}▏"
            self.put(1, L["title"], shown, curses.A_BOLD)
        else:
            self.put(1, L["title"], "filter: type to search   is:warm >400k block:Exp $>5 ...   ? keys", g)

    def draw_header(self, y, it, W, selected, now):
        """Block header: ▾ Gen  ·  3 sessions  ·  1 running ──────"""
        rs = it["rows"]
        n, live = len(rs), sum(1 for r in rs if r["live"])
        text = f" {'▸' if it['collapsed'] else '▾'} {it['b']}  ·  {n} session{'' if n == 1 else 's'}" + (f"  ·  {live} running" if live else "")
        if it["b"] == "Open":
            stale = sum(1 for r in rs if r["handoff"] and now - r["handoff"]["updated"] > STALE_DAYS * 86400)
            gone = sum(1 for r in rs if r.get("orphan"))
            text += (f"  ·  {stale} not updated in {STALE_DAYS} d" if stale else "") + (f"  ·  {gone} transcript gone" if gone else "")
        text += " "
        line = text + "─" * max(0, W - 1 - cells(text))
        self.put(y, 0, line, curses.A_REVERSE | curses.A_BOLD if selected else curses.A_BOLD)

    def draw_row(self, y, r, L, W, now, selected):
        c, lv, h = r["ctx"], r["live"], r["handoff"]
        size, price, left, spent = cs.ctx_cells(r)
        if selected:
            self.put(y, 0, " " * (W - 1), curses.A_REVERSE)
            at = lambda key: curses.A_REVERSE
        else:
            at = lambda key: self.A[key]
        put = self.put
        put(y, L["lab"], f"{cs.live_label(r, self.sess):>6}", at(None), 6)
        if lv:                                              # green idle, white busy
            put(y, L["dot"], "●", at("busy" if lv["status"] == "busy" else "idle"), 1)
        put(y, L["ago"], f"{cs.ago(now - r['last']):>4}", at(None), 4)
        if "id" in L:
            put(y, L["date"], time.strftime("%m-%d", time.localtime(r["created"])), at("grey"), 5)
            put(y, L["id"], r["short"], at("grey"), 8)
        if r.get("orphan"):
            span = L["spent"] + 5 - L["size"]
            put(y, L["size"], f"{'transcript gone':>{span}}", at("grey"), span)
        else:
            put(y, L["size"], f"{size:>5}", at(("clear" if c["level"] == 2 else "warn") if c and c["level"] else None), 5)
            put(y, L["price"], f"{price:>6}", at("warm" if c and c["warm"] else None), 6)
            if left:                                        # warm minutes left: yellow under 10 for an idle session
                hurry = c["left"] < 600 and not (lv and lv["status"] == "busy")
                put(y, L["left"], f"{left:>4}", at("warn" if hurry else "warmtext"), 4)
            put(y, L["spent"], f"{spent:>5}", at(None), 5)
        tw, tag = L["tw"], ""
        if r["block"] == "Open" and h:                      # the note's age; yellow when it went stale
            tag = f"{'stub' if h['parked'] else 'note'} {cs.ago(now - h['updated'])}"
        in_folder = bool(tag and L["fw"] and "id" not in L)   # narrow: the note's age takes the folder's place (the preview names it)
        title_w = tw - (cells(tag) + 1 if tag and not in_folder else 0)
        put(y, L["title"], r["title"], at(None), title_w)
        if tag:
            stale = now - h["updated"] > STALE_DAYS * 86400
            put(y, L["title"] + (tw if in_folder else title_w) + 1, tag, at("warn" if stale else "grey"))
        if L["fw"] and not in_folder:
            put(y, L["title"] + tw + 1, r["folder"], at("grey"), L["fw"])

    def preview(self, it, now):
        """(rule label, lines): what the rule above the preview names, and up to 6 lines of (text, attr) segments."""
        A, B = self.A, curses.A_BOLD
        g, sep = A["grey"], ("  ·  ", A["grey"])
        if not it:
            return "", []
        if it["t"] == "hdr":
            rs, b = it["rows"], it["b"]
            live = sum(1 for r in rs if r["live"])
            newest = max(rs, key=lambda r: r["last"])
            lines = [[(f"{b}: {len(rs)} session{'' if len(rs) == 1 else 's'}, {live} running", B)],
                     [(f"most recent: {newest['title']}  ({cs.ago(now - newest['last'])} ago)", 0)],
                     [(BLOCK_NOTES.get(b, "Enter collapses / expands this block  ·  Left / Right jump between blocks  ·  Ctrl-G flat list"), g)]]
            if b == "Open":
                notes = sorted((r for r in rs if r["handoff"]), key=lambda r: r["handoff"]["updated"])
                stale = [r for r in notes if now - r["handoff"]["updated"] > STALE_DAYS * 86400]
                if notes:
                    lines.append([(f"oldest note: {notes[0]['title']}  ({cs.ago(now - notes[0]['handoff']['updated'])} ago)",
                                   A["warn"] if stale else 0)])
                if stale:
                    lines.append([(f"{len(stale)} not updated in {STALE_DAYS} days - continue them (Enter then n) or close them (Ctrl-X)", A["warn"])])
            return f"block {b}", lines
        r = it["r"]
        c, lv, h, orphan = r["ctx"], r["live"], r["handoff"], r.get("orphan")
        when = lambda t: time.strftime("%Y-%m-%d %H:%M", time.localtime(t))
        blk = r["block"] + (f" (from {r['home_block']})" if r["block"] == "Open" and r.get("home_block") not in (None, "Open") else "")
        label = (f"{r['short']} · {blk} · transcript gone · note updated {when(r['last'])}" if orphan else
                 f"{r['short']} · {blk} · created {when(r['created'])} · last used {when(r['last'])} · {r['size'] / 1e6:.1f} MB")
        lines = [[(r["title"], B)] + ([sep, ("transcript gone", g)] if orphan else [])]
        # where: folder, then window
        if orphan:
            state = "transcript gone (Claude Code purged it) - Enter then n starts a new session from the note"
        elif lv and lv["window_id"]:
            state = (f"running in window {lv['window_index']} ({lv['status']}) - Enter jumps there" if lv["tmux_session"] == self.sess
                     else f"running in tmux session '{lv['tmux_session']}' (window {lv['window_index']}, {lv['status']}) - Enter will not jump across sessions")
        elif lv:
            state = f"running outside tmux ({cs.live_label(r)}) - cannot be opened here"
        elif self.asks(r):
            state = "idle - Enter asks: n = new session from the note or a digest, r = resume"
        else:
            state = "idle - Enter resumes it in a new window"
        lines.append([(fit_tail(tilde(r["cwd"]) or "?", max(24, (self.scr.getmaxyx()[1] - 2) // 2)), 0), sep, (state, B if lv else 0)])
        # cost: context, cache, wake, spent - what decides between resuming and starting fresh
        if c:
            lvl = ("clear" if c["level"] == 2 else "warn") if c["level"] else None
            seg = [(f"context {cs.ctx_label(c).split()[0]} tokens", A[lvl]), (f" ({(c['model'] or '?').removeprefix('claude-')})", g), sep]
            seg += ([(f"cache warm {dashlib.dur(c['left'])} more, {cs.money(c['step'])} per step", A["warmtext"])] if c["warm"]
                    else [("cache cold", 0)])
            seg += [sep, (f"wake {cs.money(c['wake'])} exact" if c.get("wake_exact") else f"wake ~{cs.money(c['wake'])}", 0)]
            if r.get("spent"):
                seg += [sep, (f"spent {cs.money(r['spent'])}", 0)]
            if c["level"]:
                seg += [sep, (f"over {cs.CTX_WARN // 1000}K: /compact soon" if c["level"] == 1
                              else f"over {cs.CTX_CLEAR // 1000}K: /clear or /compact now" if c["warm"] or lv
                              else f"over {cs.CTX_CLEAR // 1000}K: a fresh session is cheaper than resuming this one", A[lvl])]
            if c.get("misses"):
                seg += [sep, (f"{c['misses']} cache misses re-sent {cs.money(c.get('missed_usd'))}", g)]
            lines.append(seg)
        elif not orphan:
            lines.append([("no API response yet - context unknown", g)] + ([sep, (f"spent {cs.money(r['spent'])}", 0)] if r.get("spent") else []))
        # the note: its next step and age
        digest = (Path(h["path"]).with_name(Path(h["path"]).stem + ".digest.md") if h else cs.HANDOFFS / f"{r['id']}.digest.md")
        if h:
            age = now - h["updated"]
            whose = "" if Path(h["path"]).stem == r["id"] else " of the session it continues"
            lines.append([(f"note{whose} ({h['status']}{', parked stub' if h['parked'] else ''}, ", 0),
                          (f"updated {cs.ago(age)} ago", A["warn"] if age > STALE_DAYS * 86400 else 0), ("): next - ", 0),
                          (h["next"] or "?", B)])
        elif r.get("continued_by"):
            lines.append([(f"continued in session {r['continued_by'][:8]}", g)])
        elif r["last_prompt"] or r["first_prompt"]:
            lines.append([("last prompt: " + (r["last_prompt"] or r["first_prompt"]), g)])
        # where the note / digest / transcript is
        has_digest = digest.exists()
        if h:
            lines.append([(f"note {tilde(h['path'])}" + (" (+ .digest.md beside it)" if has_digest else "") + "  ·  Ctrl-V reads it", g)])
        elif has_digest:
            lines.append([(f"digest {tilde(digest)}  ·  Ctrl-V reads it", g)])
        elif r["proj_dir"]:
            lines.append([(f"transcript {tilde(cs.PROJECTS / r['proj_dir'] / (r['id'] + '.jsonl'))}  ·  no note: Ctrl-T parks it", g)])
        # the command, last
        lines.append([("no resume command: the transcript is gone - Enter then n continues from the note", g)] if orphan
                     else [(resume_cmd(r), 0)])
        return label, lines

    def draw_preview(self, y0, W, now):
        label, lines = self.preview(self.cur(), now)
        self.put(y0, 0, "─" * (W - 1), self.A["grey"])
        if label:
            self.put(y0, 2, f" {label} ", curses.A_BOLD)
        for j, segs in enumerate(lines[:6]):
            self.puts(y0 + 1 + j, 1, segs, W - 2)

    def hints(self, it, room):
        """The most useful keys for the highlighted line that fit in `room` cells, by priority, then the help key."""
        r = it["r"] if it and it["t"] == "row" else None
        want = (["Enter fold"] if it and it["t"] == "hdr" else ["Enter new from note"] if r and r.get("orphan")
                else ["Enter jump"] if r and r["live"] else ["Enter resume"] if r else [])
        if self.filter:
            want.append("Esc clear")
        want += ["←→ blocks"] if self.grouped else []
        if r and r["live"]:
            want.append("Ctrl-K end")
        want += ["Ctrl-V note", "Ctrl-X done"] if r and r["handoff"] else ["Ctrl-T park"] if r else []
        want += ["Tab all/idle/running", "Ctrl-S sort", "Ctrl-G flat" if self.grouped else "Ctrl-G blocks", "Ctrl-O stubs",
                 "Ctrl-Y copy", "Ctrl-R refresh"]
        last = "? keys" if not self.filter else "Ctrl-/ keys"
        out = []
        for h in want:
            if cells(" · ".join(out + [h, last])) > room:
                break
            out.append(h)
        return " · ".join(out + [last])

    def draw_bottom(self, H, W):
        if self.confirm and time.time() > self.confirm["until"]:
            self.confirm = None
            self.say("cancelled", 2)
        if self.confirm:
            self.put(H - 1, 0, pad(" " + fit(self.confirm["prompt"], W - 3), W - 1), curses.A_REVERSE | curses.A_BOLD)
        elif time.time() < self.msg_until:
            self.put(H - 1, 1, self.msg, curses.A_BOLD)
        else:
            self.put(H - 1, 1, self.hints(self.cur(), W - 3), self.A["grey"])

    def draw_help(self, H, W):
        y = 0
        for text, style in HELP:
            if y >= H:
                break
            if style == "legend":
                A = self.A
                self.puts(y, 1, [("cache warm ", 0), ("$.05", A["warm"]), (" per step, ", 0), ("12m", A["warmtext"]),
                                 (" left (", 0), ("4m", A["warn"]), (" running out)   cold ", 0), ("↻$2.5", 0),
                                 (" to wake it", 0)] if text.endswith("1") else
                          [("context ", 0), (f"{cs.CTX_WARN // 1000}K+", A["warn"]), (" ", 0), (f"{cs.CTX_CLEAR // 1000}K+", A["clear"]),
                           ("   ", 0), ("●", A["idle"]), (" idle ", 0), ("●", A["busy"]), (" busy   ", 0),
                           (f"note {STALE_DAYS + 1}d", A["warn"]), (" stale   ", 0), ("grey", A["grey"]), (" = secondary", 0)])
            else:
                self.put(y, 1, text, curses.A_BOLD if style == "bold" else 0)
            y += 1

    # ---- input ----
    def arm_kill(self):
        r = self.cur_row()
        if not r:
            return self.say("select a session to end it", 3)
        if r.get("orphan"):
            return self.say("transcript gone - nothing is running to end (Ctrl-X closes the note)", 5)
        lv = r["live"]
        if not lv:
            return self.say("not running - nothing to end", 3)
        busy = lv["status"] == "busy"
        where = (f"window {lv['window_index']}" if lv["window_index"] is not None
                 else "background session" if "back" in (lv["kind"] or "") or lv["kind"] == "bg" else "outside tmux")
        what = f"'{fit(r['title'], 40)}' ({where}, {lv['status']})"
        key = "Y" if busy else "y"
        prompt = (f"BUSY - working right now: {what}.  Capital Y = end it anyway, any other key cancels" if busy
                  else f"End {what}?  y = end it, any other key cancels")
        self.confirm = {"keys": {key: lambda: self.do_kill(r["id"])}, "prompt": prompt, "until": time.time() + 8}

    def arm_continue(self, r):
        """Enter on an idle session with a handoff note, or big and cold, or whose transcript is gone: a fresh session on its
        thread (n), or resume it (r). `r` is fresh()."""
        c = r["ctx"]
        on = f" on {c['model'].removeprefix('claude-')}" if c and c.get("model") else ""
        if r["cont"]:
            if r.get("orphan"):
                return self.say(f"already continued as {r['cont'][:8]} - Ctrl-X closes this note", 6)
            self.confirm = {"keys": {"r": lambda: self.run(lambda: self.resume(r))},
                            "prompt": f"already continued as {r['cont'][:8]}  ·  r = resume this old one anyway  ·  any other key cancels",
                            "until": time.time() + 20}
            return
        if r.get("orphan"):
            self.confirm = {"keys": {"n": lambda: self.run(lambda: self.continue_(r))},
                            "prompt": "transcript gone: n = new session from its note  ·  any other key cancels",
                            "until": time.time() + 20}
            return
        wake = f" ({cs.money(c['wake'])} on the first prompt)" if c and not c["warm"] else ""
        h = r["handoff"]
        src = ("its handoff note" if h and not h["parked"] and Path(h["path"]).stem == r["id"]
               else "the thread's note + a digest of this session" if h and not h["parked"] and not r.get("orphan")
               else "a digest of it (made here, free)")
        self.confirm = {"keys": {"n": lambda: self.run(lambda: self.continue_(r)),
                                 "r": lambda: self.run(lambda: self.resume(r))},
                        "prompt": f"n = new session{on} from {src}  ·  r = resume as is{wake}  ·  any other key cancels",
                        "until": time.time() + 20}

    def continue_(self, r):
        """n: a fresh session on r's thread - checked again first: nobody resumed or continued it in the meantime."""
        r = self.fresh(r)
        if r["cont"]:
            cl = r["cont_live"]
            how = (f"running, window {cl['window_index']}" if cl and cl["window_index"] is not None else "running" if cl
                   else "started a moment ago" if r["cont"] in self.launched else "it has a transcript")
            return f"already continued as {r['cont'][:8]} ({how}) - not starting a second one"
        if r["live"]:
            return f"it is running now ({cs.live_label(r, self.sess) or 'outside tmux'}) - Enter jumps there; not starting a second thread"
        new = str(uuid.uuid4())
        self.launched[new] = time.time()
        return continue_row(r, my_session(), new)

    def resume(self, r):
        """r, or Enter: resume / jump, on running state read just now. A session resumed here in the last RESUME_GRACE s
        is not resumed again: it may not have registered as running yet."""
        r = self.fresh(r)
        if not r["live"] and time.time() - self.launched.get(r["id"], 0) < RESUME_GRACE:
            return "resumed a moment ago - it is still starting; not opening a second copy"
        msg = open_row(r, my_session())
        if not r["live"]:
            self.launched[r["id"]] = time.time()
        return msg

    def run(self, action):
        try:
            self.say(action(), 8)
        except Exception as e:
            self.say(f"could not open: {e}", 10)
        self.refresh()

    def park(self):
        r = self.cur_row()
        if not r:
            return self.say("select a session to park it", 3)
        h = r["handoff"]
        if h and h["status"] == "open":
            if r.get("orphan"):
                return self.say("transcript gone - its note is open already: Enter then n continues it, Ctrl-X closes it", 6)
            return self.say("already in Open - Enter then n continues it, Ctrl-X marks it done", 5)
        model = None
        try:
            if h:
                cs.set_handoff_status(h["path"], "open")
            else:
                cs.park(r)
                model = cs.polish_park_later(r["id"])
        except Exception as e:
            return self.say(f"could not park it: {e}", 10)
        self.refresh()
        warm = r["ctx"] and r["ctx"]["warm"] and r["live"]
        how = f"{model} is writing the note from the digest (~15 s)" if model else "no AI call"
        self.say(f"parked in Open ({how}): {fit(r['title'], 40)}" + (" - it is warm: /handoff in it would write a fuller note" if warm else ""), 8)

    def toggle_done(self):
        r = self.cur_row()
        if not r:
            return self.say("select a session to mark its note done", 3)
        h = r["handoff"]
        if not h:
            return self.say("no handoff note for this session - run /handoff in it, or Enter then n to continue it from a digest", 6)
        status = "done" if h["status"] == "open" else "open"
        try:
            cs.set_handoff_status(h["path"], status)
        except Exception as e:                   # the note went away (or was rewritten) since the last refresh
            self.refresh()
            return self.say(f"could not mark the note {status}: {e}", 8)
        self.refresh()
        if r.get("orphan") and status == "done":
            return self.say(f"done: {fit(r['title'], 40)} - its transcript is gone, so it leaves the list (the note stays in {tilde(cs.HANDOFFS)})", 8)
        self.say(f"{'done - it left' if status == 'done' else 'open again - back in'} the Open block: {fit(r['title'], 50)}")

    def view_note(self):
        """Ctrl-V: the thread's note - or its digest when there is only a parked stub or no note - in a tmux popup."""
        r = self.cur_row()
        if not r:
            return self.say("select a session to read its note", 3)
        h = r["handoff"]
        digest = Path(h["path"]).with_name(Path(h["path"]).stem + ".digest.md") if h else cs.HANDOFFS / f"{r['id']}.digest.md"
        path = (h["path"] if h and not h["parked"] else digest if digest.exists() else h["path"] if h else None)
        if not path or not os.path.exists(path):
            return self.say("no handoff note and no digest for this session - Ctrl-T parks it (writes both, no API call)", 6)
        pane = os.environ.get("TMUX_PANE")
        if not pane:
            return self.say(f"not in tmux - read {tilde(path)}", 8)
        cmd = ["tmux", "display-popup", "-E", "-w", "90%", "-h", "90%", "-t", pane]
        try:
            win = tmux("display-message", "-p", "-t", pane, "#{window_id}")
            clients = [l.split() for l in tmux("list-clients", "-F", "#{client_activity} #{window_id} #{client_name}").splitlines()]
            mine = sorted((c for c in clients if len(c) == 3 and c[1] == win), reverse=True)
            if mine:
                cmd += ["-c", mine[0][2]]            # the client looking at this window, the latest active if several
        except RuntimeError:
            pass
        title = fit(r['title'], 60).replace("#", "##")   # -T is a tmux format: a `#(cmd)` in a title would run
        cmd += ["-T", f" {title} - q closes ", f"less -R -c {shlex.quote(str(path))}"]
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        self.say(f"reading {tilde(path)} in a popup - q closes it", 5)

    def do_kill(self, sid):
        self.refresh()
        r = next((x for x in self.all_rows if x["id"] == sid), None)
        if not r or not r["live"]:
            return self.say("already stopped", 3)
        self.say(f"ending {r['short']} ...", 10)
        self.draw()
        try:
            self.say(end_session(r), 10)
        except Exception as e:
            self.say(f"could not end it: {e}", 10)
        self.refresh()

    def is_collapsed(self, b):
        return b in self.collapsed or (b in DEFAULT_COLLAPSED and b not in self.expanded)

    def toggle_block(self, b):
        if self.is_collapsed(b):
            self.collapsed.discard(b)
            self.expanded.add(b)
        else:
            self.expanded.discard(b)
            self.collapsed.add(b)
        self.save_state()
        self.apply_filter()

    def jump_block(self, step):
        hdrs = [n for n, it in enumerate(self.items) if it["t"] == "hdr"]
        target = [n for n in hdrs if (n > self.sel if step > 0 else n < self.sel)]
        if target:
            self.sel = target[0] if step > 0 else target[-1]
        self.remember()

    def key(self, k):
        if k == curses.KEY_RESIZE:               # redrawn at the new size; a question or the help stays up
            return
        if self.help:                            # any key closes the help, and does nothing else
            self.help = False
            return
        if self.confirm:                         # second step of Ctrl-K or Enter: one of the asked keys acts, anything else cancels
            c, self.confirm = self.confirm, None
            act = c["keys"].get(k) if isinstance(k, str) else None
            if act and time.time() <= c["until"]:
                return act()
            return self.say("cancelled", 2)
        if isinstance(k, str):
            if k in ("\n", "\r"):
                return self.activate()
            if (k == "?" and not self.filter) or k == "\x1f":     # ? (a filter can still contain one) or Ctrl-/
                self.help = True
                return
            if k in ("\x7f", "\b"):
                self.filter = self.filter[:-1]
                self.force_first = True
            elif k in ("\x1b", "\x15"):          # Esc, Ctrl-U
                self.filter = ""
                self.force_first = True
            elif k == "\t":
                self.mode = (self.mode + 1) % len(MODES)
            elif k == "\x0f":                    # Ctrl-O
                self.show_hidden = not self.show_hidden
            elif k == "\x07":                    # Ctrl-G: by block / flat
                self.grouped = not self.grouped
                self.save_state()
            elif k == "\x13":                    # Ctrl-S: the sort within blocks
                self.sort = (self.sort + 1) % len(SORTS)
                self.save_state()
                self.say(f"sorted by {SORTS[self.sort]}" + (" (Open: oldest note first)" if SORTS[self.sort] == "recent" else ", highest first"), 3)
            elif k == "\x12":                    # Ctrl-R
                return self.refresh()
            elif k == "\x0b":                    # Ctrl-K
                return self.arm_kill()
            elif k == "\x18":                    # Ctrl-X: the thread is done (or open again)
                return self.toggle_done()
            elif k == "\x14":                    # Ctrl-T: park it in Open without waking it
                return self.park()
            elif k == "\x16":                    # Ctrl-V: read the note
                return self.view_note()
            elif k == "\x19":                    # Ctrl-Y
                r = self.cur_row()
                if r and r.get("orphan"):
                    return self.say("transcript gone - no resume command to copy; Enter then n continues from the note", 6)
                if r:
                    copy_text(resume_cmd(r))
                    self.say(f"copied: {resume_cmd(r)}")
                return
            elif k == "\x0e":
                self.sel += 1
                return self.remember()
            elif k == "\x10":
                self.sel -= 1
                return self.remember()
            elif k.isprintable():
                self.filter += k
                self.force_first = True
            else:
                return                           # every other control key (Ctrl-C, Ctrl-Z, Ctrl-D ...) is ignored
            self.apply_filter()
            return
        H = self.scr.getmaxyx()[0]
        page = max(1, H - 11)
        moves = {curses.KEY_DOWN: 1, curses.KEY_UP: -1, curses.KEY_NPAGE: page, curses.KEY_PPAGE: -page}
        if k in moves:
            self.sel += moves[k]
        elif k == curses.KEY_RIGHT:
            return self.jump_block(1)
        elif k == curses.KEY_LEFT:
            return self.jump_block(-1)
        elif k == curses.KEY_HOME:
            self.sel = 0
        elif k == curses.KEY_END:
            self.sel = len(self.items) - 1
        elif k == curses.KEY_BACKSPACE:
            self.filter = self.filter[:-1]
            self.force_first = True
            return self.apply_filter()
        elif k == curses.KEY_ENTER:
            return self.activate()
        elif k == curses.KEY_F1:
            self.help = True
            return
        self.remember()

    def activate(self):
        it = self.cur()
        if not it:
            return
        if it["t"] == "hdr":                     # Enter on a block header folds / unfolds it
            return self.toggle_block(it["b"])
        r = self.fresh(it["r"])                  # running state as of now, not of the last refresh
        if not r["live"] and self.asks(r):
            return self.arm_continue(r)          # a note to start from, waking it would be dear, or nothing to resume: ask
        self.run(lambda: self.resume(r))

    def loop(self):
        while True:
            self.draw()
            try:
                k = self.scr.get_wch()
            except curses.error:
                k = None
            now = time.time()
            if k is not None:
                if k != curses.KEY_RESIZE:
                    self.seen, self.seen_at = True, now          # a key: someone is looking
                self.key(k)
                continue
            if now - self.seen_at >= VISIBLE_EVERY:
                was, self.seen, self.seen_at = self.seen, dashlib.visible(), now
                if self.seen and not was:                       # back on screen: fresh data at once
                    self.refresh()
                    continue
            if self.seen and now - self.last_refresh > REFRESH_S:
                self.refresh()


def main(scr):
    curses.raw()                                 # Ctrl-C / Ctrl-Z / Ctrl-\ arrive as plain keys, which we ignore
    Picker(scr).loop()


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTSTP, signal.SIG_IGN)
    try:
        curses.wrapper(main)
    except Exception:
        ERRLOG.parent.mkdir(parents=True, exist_ok=True)
        ERRLOG.write_text(time.strftime("%F %T\n") + traceback.format_exc())
        raise
