#!/usr/bin/env python3
"""HPC SLURM widget for the tmux dashboard: my queue + the last 24 h of finished jobs.

Polls `ssh $SLURM_HOST` (the alias keeps a ControlMaster open, so no new logins):
squeue every 60 s, sacct every 5 min - sacct is slow and hits the accounting DB.
All dashboards share one cache (~/.claude/dash/slurm.json) behind a lock file,
so two monitors do not mean two pollers. Fetching runs in a thread; the pane
keeps redrawing from the cache meanwhile, and neither runs while nobody looks.
A failed squeue or sacct keeps the last good rows on screen, under the error.
"""
import json, os, re, shutil, subprocess, sys, tempfile, threading, time
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import dashlib


def conf(key, default=""):
    """KEY=VALUE from ~/.config/tmux-dashboard/config (environment wins); written by install.sh."""
    if key in os.environ:
        return os.environ[key]
    try:
        for line in (Path.home() / ".config" / "tmux-dashboard" / "config").read_text().splitlines():
            k, _, v = line.partition("=")
            if k.strip() == key and not line.lstrip().startswith("#"):
                return v.strip().strip("\"'")
    except OSError:
        pass
    return default


HOST, USER = conf("SLURM_HOST"), conf("SLURM_USER")
SQUEUE_EVERY, SACCT_EVERY = 60, 300
RETRY = 30                      # s to the next try after a failure, instead of every tick
SSH_TIMEOUT = 90                # s; then the ControlMaster is closed, since one left dead by the Mac sleeping hangs every call
DASH = Path.home() / ".claude" / "dash"
CACHE, LOCK = DASH / "slurm.json", DASH / "slurm.lock"
DIM, BOLD, OFF = "\033[2m", "\033[1m", "\033[0m"
GREEN, YELLOW, RED, CYAN = "\033[32m", "\033[33m", "\033[31m", "\033[36m"
BAD = ("FAILED", "TIMEOUT", "OUT_OF_MEMORY", "NODE_FAIL", "BOOT_FAIL", "DEADLINE", "PREEMPTED")


def read_cache():
    try:
        return json.loads(CACHE.read_text())
    except (OSError, ValueError):
        return {}


def fetch():
    """Refresh whatever is stale. One ssh call; at most one fetcher at a time across panels. Each section reports its
    own exit code (@@RC): only a section that worked replaces its rows and its time, so a failure (controller down,
    accounting DB away) keeps the last good rows and sets the error line instead of showing an empty queue."""
    cache, now = read_cache(), time.time()
    want_q = now - cache.get("squeue_at", 0) > SQUEUE_EVERY and now >= cache.get("squeue_retry", 0)
    want_a = now - cache.get("sacct_at", 0) > SACCT_EVERY and now >= cache.get("sacct_retry", 0)
    if not (want_q or want_a) or now < cache.get("retry_at", 0):
        return
    DASH.mkdir(parents=True, exist_ok=True)
    try:
        if LOCK.exists() and now - LOCK.stat().st_mtime > 180:
            LOCK.unlink()  # a fetcher died mid-flight
        os.close(os.open(LOCK, os.O_CREAT | os.O_EXCL))
    except OSError:
        return
    try:
        wanted, parts = [], []
        if want_q:
            wanted.append(("Q", "squeue"))
            parts.append(f"echo @@Q; squeue -u {USER} -h -o '%i|%j|%T|%M|%l|%P|%R' 2>&1; echo \"@@RC $?\"")
        if want_a:
            wanted.append(("A", "sacct"))
            parts.append(f"echo @@A; sacct -u {USER} -X -n -P -S now-24hours -o JobID,JobName%40,State,Elapsed,End,Partition"
                         f" 2>&1; echo \"@@RC $?\"")
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", HOST, "; ".join(parts)],
                           capture_output=True, text=True, timeout=SSH_TIMEOUT)
        section, rows, rc, said = None, {"Q": [], "A": []}, {}, {}
        for line in r.stdout.splitlines():
            if line.startswith("@@RC "):
                rc[section] = int(line[5:]) if line[5:].strip().isdigit() else -1
            elif line.startswith("@@"):
                section = line[2:3]
            elif section and "|" in line:
                rows[section].append(line.split("|"))
            elif section and line.strip():
                said[section] = line.strip()              # squeue / sacct's own message (stderr is folded into stdout)
        ssh_err = (r.stderr.strip().splitlines() or [f"ssh exit {r.returncode}"])[-1]
        errors = []
        for sec, name in wanted:
            key, every = ("squeue", SQUEUE_EVERY) if sec == "Q" else ("sacct", SACCT_EVERY)
            if rc.get(sec) == 0:
                cache[key], cache[key + "_at"], cache[key + "_retry"], cache[key + "_error"] = rows[sec], now, 0, None
            elif sec in rc:                               # it ran and failed (accounting DB down ...): retry at half its pace
                cache[key + "_retry"] = now + max(RETRY, every // 2)
                cache[key + "_error"] = f"{name}: " + said.get(sec, f"exit {rc[sec]}").removeprefix(f"{name}: ")
                errors.append(cache[key + "_error"])
            else:                                         # ssh failed before the section ran
                errors.append(ssh_err)
        asked = {"squeue" if sec == "Q" else "sacct" for sec, _ in wanted}
        errors += [cache[k + "_error"] for k in ("squeue", "sacct") if k not in asked and cache.get(k + "_error")]   # still failing, in backoff
        cache["error"] = " · ".join(dict.fromkeys(errors))[:200] or None
    except subprocess.TimeoutExpired:
        cache["error"] = f"no reply from {HOST} in {SSH_TIMEOUT} s"
        try:   # a slow sacct on a healthy connection is no reason to drop it: probe it first
            subprocess.run(["ssh", "-o", "BatchMode=yes", HOST, "true"], capture_output=True, timeout=15)
        except subprocess.TimeoutExpired:
            cache["error"] += ": the next try opens a fresh ssh connection"
            try:   # stop, not exit: the shared master stops taking new sessions, while your open ssh shells to the cluster stay up
                subprocess.run(["ssh", "-O", "stop", HOST], capture_output=True, timeout=10)
            except (OSError, subprocess.SubprocessError):
                pass
        except (OSError, subprocess.SubprocessError):
            pass
    except (OSError, subprocess.SubprocessError) as e:
        cache["error"] = f"{type(e).__name__}: cluster unreachable"
    finally:
        cache["retry_at"] = time.time() + RETRY if cache.get("error") else 0   # from now: a timeout took 90 s
        fd, tmp = tempfile.mkstemp(dir=DASH, prefix=".tmp-")
        with os.fdopen(fd, "w") as fh:
            json.dump(cache, fh)
        os.replace(tmp, CACHE)
        try:
            LOCK.unlink()
        except OSError:
            pass


def clip(text, n):
    return text if len(text) <= n else text[:n - 1] + "…"


ANSI = re.compile(r"\033\[[0-9;]*m")


def fit(line, width):
    """Truncate to `width` visible cells, keeping escape codes intact - a wrapped line would scroll the pane."""
    out, seen, pos = [], 0, 0
    for m in ANSI.finditer(line):
        chunk = line[pos:m.start()]
        take = max(0, min(len(chunk), width - seen))
        out.append(chunk[:take]); seen += take
        out.append(m.group()); pos = m.end()
    chunk = line[pos:]
    out.append(chunk[:max(0, width - seen)])
    return "".join(out) + OFF


def render():
    cols, height = shutil.get_terminal_size()
    c, now = read_cache(), time.time()
    queue = c.get("squeue") or []
    done = [r for r in (c.get("sacct") or []) if len(r) >= 6 and not r[2].startswith(("RUNNING", "PENDING"))]
    done.sort(key=lambda r: r[4], reverse=True)   # most recent first
    running = sum(1 for r in queue if r[2] == "RUNNING")
    ok = sum(1 for r in done if r[2].startswith("COMPLETED"))
    bad = sum(1 for r in done if r[2].startswith(BAD))
    cancelled = sum(1 for r in done if r[2].startswith("CANCELLED"))
    fresh = f"updated {dashlib.dur(now - c['squeue_at'])} ago" if c.get("squeue_at") else "waiting for first reply…"
    wide = cols >= 120
    head = (f"{BOLD} HPC · SLURM{OFF}" + (f"{DIM}  {USER}@{HOST}{OFF}" if wide else "") + f"   {CYAN}▶ {running} running{OFF} · "
            f"{YELLOW}◷ {len(queue) - running} queued{OFF}   {DIM}24h:{OFF} {GREEN}✔ {ok}{OFF}  "
            f"{RED if bad else DIM}✘ {bad}{OFF}  {DIM}⊘ {cancelled}" + (" cancelled" if wide else "") + f"   {fresh}{OFF}")
    out = [head]
    if c.get("error"):
        out.append(f" {RED}{clip(c['error'], cols - 2)}{OFF}")
        out.append(f"{DIM} showing the last good data" + ("" if c["error"].startswith(("squeue:", "sacct:")) else
                   f" · `ssh {HOST}` once in any window re-opens the connection") + OFF)   # ssh itself failed
    name_w = max(10, min(36, cols - (70 if cols >= 100 else 58)))
    show_part = cols >= 100   # partition column only when there is room
    for r in sorted(queue, key=lambda r: (r[2] != "RUNNING", r[0])):
        jid, name, state, used, limit, part, why = (r + [""] * 7)[:7]
        colour = CYAN if state == "RUNNING" else YELLOW
        out.append(f" {colour}{'▶' if state == 'RUNNING' else '◷'} {jid:<9}{OFF} {clip(name, name_w):<{name_w}} "
                   f"{colour}{state.lower():<10}{OFF} {used:>10} / {limit:<11} {DIM}" + (f"{clip(part, 18):<18} " if show_part else "") + f"{clip(why, 24)}{OFF}")
    if not queue and not c.get("error"):
        out.append(f"{DIM}   nothing running or queued{OFF}")
    for r in done:
        jid, name, state, elapsed, end, part = r[:6]
        word = state.split()[0]
        colour, mark = (GREEN, "✔") if word == "COMPLETED" else (RED, "✘") if word in BAD else (DIM, "⊘")
        when = end[11:16] if end[:10] == time.strftime("%Y-%m-%d") else end[5:16].replace("T", " ")
        out.append(f" {colour}{mark} {jid:<9}{OFF} {clip(name, name_w):<{name_w}} {colour}{word.lower():<10}{OFF} "
                   f"{elapsed:>10}   {DIM}ended {when:<11}" + (f" {clip(part, 18)}" if show_part else "") + OFF)
    hidden = len(out) - height
    if hidden > 0:
        out = out[:height - 1] + [f"{DIM}   … {hidden + 1} more finished jobs in the last 24 h{OFF}"]
    out = [fit(l, cols - 1) for l in out]
    return "\033[H" + "".join(l + "\033[K\n" for l in out).rstrip("\n") + "\033[J"


if not HOST or not USER:
    sys.stdout.write("\033[2J\033[H SLURM: set SLURM_HOST and SLURM_USER in ~/.config/tmux-dashboard/config")
    sys.stdout.flush()
    while "--once" not in sys.argv:
        time.sleep(3600)
    sys.exit(0)
if "--once" in sys.argv:
    fetch()
    print(render())
    sys.exit(0)
screen = dashlib.Screen()
sys.stdout.write("\033[?25l\033[2J")
try:
    while True:
        if not any(t.name == "fetch" for t in threading.enumerate()):
            threading.Thread(target=fetch, name="fetch", daemon=True).start()
        screen.show(dashlib.safe(render))
        dashlib.wait(5)
except KeyboardInterrupt:
    pass
finally:
    sys.stdout.write("\033[?25h\n")
