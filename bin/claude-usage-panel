#!/usr/bin/env python3
"""Claude usage widget for the tmux dashboard: plan limits + context per session.

Reads the JSON that ~/.local/bin/claude-statusline saves for every session
(~/.claude/dash/status/<session>.json) - the same numbers `/usage` shows.
Idle sessions keep reporting the limits they last saw, so for each window we
trust the newest reset time and, within it, the highest percentage (usage only
grows inside a window).

The month line is what this month would have cost at API list prices (what an
Enterprise or API account is billed), from claude_sessions.spend(): every
transcript, subagents included, counted in a background thread once a minute.
"""
import calendar, json, os, re, shutil, subprocess, sys, threading, time
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import claude_sessions as cs

SPEND_EVERY = 60                                              # seconds between month-to-date recounts
_spend = {"by": None}
STATUS = Path.home() / ".claude" / "dash" / "status"
REGISTRY = Path.home() / ".claude" / "sessions"
DIM, BOLD, OFF = "\033[2m", "\033[1m", "\033[0m"
GREEN, YELLOW, RED = "\033[32m", "\033[33m", "\033[31m"


def level(p):
    return GREEN if p < 60 else YELLOW if p < 80 else RED


def bar(p, width):
    full = round(max(0.0, min(100.0, p)) / 100 * width)
    return f"{level(p)}{'█' * full}{OFF}{DIM}{'░' * (width - full)}{OFF}"


def span(seconds):
    seconds = max(0, int(seconds))
    d, h, m = seconds // 86400, seconds % 86400 // 3600, seconds % 3600 // 60
    return f"{d}d{h:02d}h" if d else f"{h}h{m:02d}m" if h else f"{m}m"


def load():
    out = []
    for f in STATUS.glob("*.json"):
        try:
            out.append(json.loads(f.read_text()))
        except (OSError, ValueError):
            pass
    return out


def live_windows():
    """{session_id: tmux window index} for Claude processes that are still running."""
    try:
        panes = dict(l.split() for l in subprocess.run(
            ["tmux", "list-panes", "-a", "-F", "#{pane_id} #{window_index}"],
            capture_output=True, text=True).stdout.splitlines())
    except (OSError, ValueError):
        panes = {}
    live = {}
    for f in REGISTRY.glob("*.json"):
        try:
            s = json.loads(f.read_text())
            os.kill(s["pid"], 0)
        except (OSError, ValueError, KeyError):
            continue
        last = max(s.get("statusUpdatedAt", 0), s.get("updatedAt", 0), s.get("startedAt", 0))
        live[s.get("sessionId")] = (panes.get(s.get("tmux", "").rpartition(".")[2], "-"), last)
    return live


def limit(status, key, now):
    best = None
    for s in status:
        w = (s.get("rate_limits") or {}).get(key) or {}
        if w.get("used_percentage") is None or (w.get("resets_at") or 0) <= now:
            continue
        cand = (w["resets_at"], w["used_percentage"])
        best = max(best, cand) if best else cand
    return best


def count_spend():
    while True:
        try:
            _spend["by"] = cs.spend()
        except Exception:
            pass                                              # keep the last count; the panel must never die on this
        time.sleep(SPEND_EVERY)


def month_line(now, cols):
    """' Oct at API prices $1,210 · pace $1,900 · Sep $1,750' - pace = so far / share of the month gone."""
    by = _spend["by"]
    if by is None:
        return f"{DIM} month to date: counting the transcripts…{OFF}"
    lt = time.localtime(now)
    start = time.mktime((lt.tm_year, lt.tm_mon, 1, 0, 0, 0, 0, 0, -1))
    prev = time.localtime(start - 86400)
    mtd = by.get(time.strftime("%Y-%m", lt), 0)
    pace = mtd / max((now - start) / 86400, 0.5) * calendar.monthrange(lt.tm_year, lt.tm_mon)[1]
    last = by.get(time.strftime("%Y-%m", prev))
    text = f" {time.strftime('%b', lt)} at API prices {BOLD}${mtd:,.0f}{OFF}{DIM} · pace ${pace:,.0f}"
    plain = len(f" {time.strftime('%b', lt)} at API prices ${mtd:,.0f} · pace ${pace:,.0f}")
    extra = f" · {time.strftime('%b', prev)} ${last:,.0f}" if last else ""
    return text + (extra if plain + len(extra) <= cols - 1 else "") + OFF


def render():
    cols, rows = shutil.get_terminal_size()
    now, status, live = time.time(), load(), live_windows()
    out = [f"{BOLD} Claude usage{OFF}{DIM}  plan limits, as in /usage{OFF}"]
    bw = max(6, min(24, cols - 41))
    for key, label in (("five_hour", "5-hour"), ("seven_day", "7-day ")):
        got = limit(status, key, now)
        if not got:
            out.append(f" {label} {DIM}no fresh reading yet - use any session once{OFF}")
            continue
        resets, used = got
        when = time.strftime("%H:%M" if resets - now < 86400 else "%a %H:%M", time.localtime(resets))
        out.append(f" {label} {bar(used, bw)} {level(used)}{used:3.0f}%{OFF} {DIM}resets {when} ({span(resets - now)}){OFF}")
    out.append(month_line(now, cols))

    sessions = sorted(((live[s.get("session_id")][0], s) for s in status if s.get("session_id") in live),
                      key=lambda t: -live[t[1]["session_id"]][1])   # most recently used first, like the sessions panel
    if sessions:
        out += ["", f"{BOLD} Context per session{OFF}{DIM}  % of window · prompt cache{OFF}"]
        cw_bar = max(6, min(18, cols - 36))
        for win, s in sessions:
            cw = s.get("context_window") or {}
            p = cw.get("used_percentage")
            if p is None:
                continue
            model = re.sub(r"^Claude ", "", (s.get("model") or {}).get("display_name") or "?")[:9]
            pc = s.get("prompt_cache") or {}
            left = (pc.get("expires_at") or 0) - now
            warm = pc.get("warm") and left > 0
            cache = f"warm {span(left)}" if warm else "cold" if pc else ""
            tint = "\033[38;5;208m" if warm else "\033[38;5;75m"          # orange warm, sky blue cold, as in the sessions panel
            out.append(f" {win:>2} {bar(p, cw_bar)} {level(p)}{p:3.0f}%{OFF} {model:<9} {tint}{cache}{OFF}")
        cost = sum((s.get("cost") or {}).get("total_cost_usd") or 0 for _, s in sessions)
        out.append(f"{DIM} live sessions ≈ ${cost:,.0f} at API prices (covered by the plan){OFF}")
    out = out[:max(rows, 1)]
    return "\033[H" + "".join(l + "\033[K\n" for l in out).rstrip("\n") + "\033[J"


if "--once" in sys.argv:
    _spend["by"] = cs.spend()
    print(render())
    sys.exit(0)
threading.Thread(target=count_spend, daemon=True).start()
sys.stdout.write("\033[?25l\033[2J")
try:
    while True:
        sys.stdout.write(render())
        sys.stdout.flush()
        time.sleep(5)
except KeyboardInterrupt:
    pass
finally:
    sys.stdout.write("\033[?25h\n")
