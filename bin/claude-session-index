#!/usr/bin/env python3
"""List Claude Code sessions: when, where, what, and the id to resume.

    claude-session-index                 table, newest use first (stubs continued elsewhere and empty sessions hidden)
    claude-session-index pcr exp0115     only rows containing every word (title, folder, id, prompts)
    claude-session-index --idle          only sessions that are not running now
    claude-session-index --live          only running ones
    claude-session-index --block Exp     only that block (Gen, Cyt, Seq, Exp ... ~ = started in the home folder)
    claude-session-index --all           also the stubs
    claude-session-index -n 20           first 20 rows
    claude-session-index --json          machine-readable rows
    claude-session-index --weekly        this ISO week as Markdown: open threads and their next step, the 5 costliest
                                         sessions, spend by block and by model against the week before. Printed, or
                                         written to <DIR>/Claude week <YYYY-Www>.md with --out DIR or the setting
                                         WEEKLY_EXPORT_DIR (empty = print); --week 2026-W42 (or "last") for another week
"""
import argparse, json, os, re, sys, time
from datetime import date, timedelta
from pathlib import Path
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import claude_sessions as cs


def main():
    ap = argparse.ArgumentParser(description="List Claude Code sessions.")
    ap.add_argument("words", nargs="*", help="filter: rows must contain every word")
    ap.add_argument("--idle", action="store_true"), ap.add_argument("--live", action="store_true")
    ap.add_argument("--all", action="store_true", help="include stubs continued in another session and empty sessions")
    ap.add_argument("-n", type=int, default=0, help="limit rows")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--block", help="only this block (experiment code, Other, ~, or a topic such as '~ Lookups')")
    ap.add_argument("--print-topics", action="store_true", help="print the topic rules in use (save as ~/.config/tmux-dashboard/topics to edit)")
    ap.add_argument("--weekly", action="store_true", help="this week's summary as Markdown (open threads, costliest sessions, spend by block and model)")
    ap.add_argument("--week", help="with --weekly: an ISO week such as 2026-W42, or 'last' (default: this week, so far)")
    ap.add_argument("--out", metavar="DIR", help="with --weekly: write '<DIR>/Claude week <YYYY-Www>.md' instead of printing (default: WEEKLY_EXPORT_DIR)")
    a = ap.parse_args()

    if a.weekly:
        return weekly(a)

    if a.print_topics:
        print(cs.TOPICS_FILE.read_text() if cs.TOPICS_FILE.exists() else cs.DEFAULT_TOPICS, end="")
        return
    rows = cs.build()
    if not a.all:
        rows = [r for r in rows if not (r["folded"] or r["empty"])]
    if a.idle:
        rows = [r for r in rows if not r["live"]]
    if a.live:
        rows = [r for r in rows if r["live"]]
    if a.block:
        rows = [r for r in rows if r["block"].lower() == a.block.lower()]
    words = [w.lower() for w in a.words]
    rows = [r for r in rows if cs.matches(r, words)]
    if a.n:
        rows = rows[:a.n]
    if a.json:
        json.dump(rows, sys.stdout, indent=1)
        return
    now = time.time()
    bw = max([5] + [len(r["block"]) for r in rows])      # topic blocks like "~ Notes & writing" are long
    print(f"{'LAST':>5}  {'CREATED':<10}  {'BLOCK':<{bw}}  {'LIVE':<6}  {'ID':<8}  {'MB':>5}  TITLE  [folder]")
    for r in rows:
        print(f"{cs.ago(now - r['last']):>5}  {time.strftime('%Y-%m-%d', time.localtime(r['created'])):<10}  "
              f"{r['block']:<{bw}}  {cs.live_label(r):<6}  {r['short']:<8}  {r['size'] / 1e6:>5.1f}  {r['title'][:70]}  [{r['folder']}]")
    print(f"{len(rows)} sessions", file=sys.stderr)


def weekly(a):
    week = a.week
    if week == "last":
        week = cs._week((date.today() - timedelta(days=7)).isoformat())
    elif week:
        try:
            if not re.fullmatch(r"\d{4}-W\d{2}", week):
                raise ValueError
            cs.week_days(week)                                # W00 / W54 pass the pattern but are no week
        except ValueError:
            sys.exit(f"--week {week}: use an ISO week such as 2026-W42, or 'last'")
    week, text = cs.weekly_markdown(week)
    out = a.out or os.path.expanduser(cs.setting("WEEKLY_EXPORT_DIR", ""))
    if not out:
        print(text, end="")
        return
    path = Path(out) / f"Claude week {week}.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text)
    os.replace(tmp, path)
    print(f"wrote {path}", file=sys.stderr)


if __name__ == "__main__":
    main()
